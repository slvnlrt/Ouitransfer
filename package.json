{
  "name": "ouitransfer-monorepo",
  "version": "0.0.0-dev",
  "description": "Ouitransfer monorepo — self-hosted file transfer",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "type-check": "turbo type-check",
    "validate": "turbo validate",
    "test": "turbo test",
    "dev:server": "turbo dev --filter=ouitransfer-api",
    "dev:web": "turbo dev --filter=ouitransfer-web",
    "dev:docs": "turbo dev --filter=ouitransfer-docs",
    "build:server": "turbo build --filter=ouitransfer-api",
    "build:web": "turbo build --filter=ouitransfer-web",
    "build:docs": "turbo build --filter=ouitransfer-docs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "knip": "knip"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "fast-xml-builder": ">=1.1.7",
      "fast-xml-parser": ">=5.7.2",
      "zod@^4.0.0": "4.4.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.60.0",
    "@lhci/cli": "^0.14.0",
    "knip": "^6.6.0",
    "lefthook": "^2.1.6",
    "turbo": "^2.9.14",
    "vitest": "catalog:"
  }
}
