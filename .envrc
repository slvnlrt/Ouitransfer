# Ouitransfer development environment
# Requires direnv: https://direnv.net/

# Load root .env if it exists (for shared env vars)
# Note: each app also has its own .env (apps/server/.env, apps/web/.env)
# which is loaded by the app itself via dotenv. Per-app .env takes precedence.
dotenv_if_exists

# Add local node_modules binaries to PATH
PATH_add node_modules/.bin
