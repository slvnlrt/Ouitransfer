{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", ".node-version"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsconfig*.json"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV"],
      "passThroughEnv": [
        "JWT_SECRET",
        "API_BASE_URL",
        "OAUTH_ALLOWED_REDIRECT_HOSTS",
        "ALLOWED_IMAGE_HOSTS",
        "CSP_CONNECT_SOURCES",
        "NEXT_PUBLIC_LOG_LEVEL",
        "NEXT_PUBLIC_DEFAULT_LANGUAGE",
        "ANALYZE"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "biome.json", "package.json"]
    },
    "type-check": {
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig.json", "tsconfig*.json", "package.json"]
    },
    "format": {
      "cache": false
    },
    "validate": {
      "dependsOn": ["lint", "type-check"]
    },
    "test": {
      "inputs": ["src/**/*.{ts,tsx}", "vitest.config.*", "package.json"],
      "outputs": ["coverage/**"]
    }
  }
}
