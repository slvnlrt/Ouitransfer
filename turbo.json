{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", ".node-version"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsconfig*.json"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "biome.json", "package.json"]
    },
    "type-check": {
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig.json", "tsconfig*.json", "package.json"]
    },
    "format": {
      "cache": false
    },
    "validate": {
      "dependsOn": ["lint", "type-check"]
    },
    "test": {
      "inputs": ["src/**/*.{ts,tsx}", "vitest.config.*", "package.json"],
      "outputs": ["coverage/**"]
    }
  }
}
