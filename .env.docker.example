# ==============================================================================
# Ouitransfer — Docker Compose Configuration
#
# Copy this file to .env and fill in the values.
# Docker Compose reads .env automatically — no extra flags needed.
#
#   cp .env.docker.example .env
#   # Edit .env with your values
#   docker compose up -d
# ==============================================================================

# ─── Public URLs ─────────────────────────────────────────────────────────────
# These two values must use the IP/domain that BROWSERS can reach.
# "localhost" only works when the browser runs on the same machine as Docker.
#
# WARNING: Use HTTPS in production. HTTP exposes presigned URL signatures
# and file contents on the wire. Browsers block mixed-content requests
# if the web app is served over HTTPS but storage uses HTTP.

# Origin of the web frontend (where users open the app in their browser).
# Used for CORS on both the API server and the storage service.
# Examples: http://localhost:5487, http://192.168.1.100:5487, https://files.example.com
FRONTEND_ORIGIN=

# Public URL of the storage service (where browsers upload/download files).
# Used for presigned URL generation and Content Security Policy.
# Examples: http://localhost:9000, http://192.168.1.100:9000, https://storage.example.com
STORAGE_PUBLIC_URL=

# ─── S3 Storage Credentials ─────────────────────────────────────────────────
# Shared between the storage service (RustFS) and the API server.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Security Secrets ───────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# All three MUST be different from each other.
JWT_SECRET=
CSRF_SECRET=
COOKIE_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────
# Uncomment and set as needed:
# OUITRANSFER_UID=1000              # UID for server process
# OUITRANSFER_GID=1000              # GID for server process
# SECURE_SITE=true                  # Set true when behind HTTPS reverse proxy
# DEFAULT_LANGUAGE=en-US            # Default UI language
# ENCRYPTION_SECRET=                # Required for LDAP — generate with: openssl rand -hex 32
