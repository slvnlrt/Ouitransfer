# ==============================================================================
# Ouitransfer — Docker Compose Configuration
#
# Copy this file to .env and fill in the values.
# Docker Compose reads .env automatically — no extra flags needed.
#
#   cp .env.docker.example .env
#   # Edit .env with your values
#   docker compose up -d
# ==============================================================================

# ─── Public URLs ─────────────────────────────────────────────────────────────
# These two values must use the IP/domain that BROWSERS can reach.
# "localhost" only works when the browser runs on the same machine as Docker.
#
# WARNING: Use HTTPS in production. HTTP exposes presigned URL signatures
# and file contents on the wire. Browsers block mixed-content requests
# if the web app is served over HTTPS but storage uses HTTP.

# Origin(s) of the web frontend (where users open the app in their browser).
# Used for CORS on both the API server and the storage service.
#
# IMPORTANT: this must list EVERY hostname the app is served on. If you expose
# Ouitransfer on several hostnames (e.g. an external domain AND an internal
# .lan host behind the same reverse proxy), list them all, comma-separated —
# the API server splits CORS_ORIGINS on commas. An origin that is reachable but
# not listed here gets a 403 ("Origin not allowed by CORS policy"), which most
# visibly breaks login (a POST, so the browser sends an Origin header).
# Examples:
#   http://localhost:5487
#   https://files.example.com
#   https://files.example.com,https://files.internal.lan
FRONTEND_ORIGIN=

# Public URL of the storage service (where browsers upload/download files).
# Used for presigned URL generation and Content Security Policy.
# Examples: http://localhost:9000, http://192.168.1.100:9000, https://storage.example.com
STORAGE_PUBLIC_URL=

# ─── S3 Storage Credentials ─────────────────────────────────────────────────
# Shared between the storage service (RustFS) and the API server.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Security Secrets ───────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# All three MUST be different from each other.
JWT_SECRET=
CSRF_SECRET=
COOKIE_SECRET=

# ─── Documentation site ─────────────────────────────────────────────────────
# The `docs` service serves the Fumadocs site, mounted under /docs. It needs no
# configuration here — the base path ("/docs") is baked into the image at build
# time. Reachable directly at http://YOUR_SERVER_IP:5488/docs, or route /docs to
# it from your reverse proxy WITHOUT stripping the prefix (see docker-compose.yaml).

# ─── Optional ───────────────────────────────────────────────────────────────
# Uncomment and set as needed:
# OUITRANSFER_UID=1000              # UID for server process
# OUITRANSFER_GID=1000              # GID for server process
# SECURE_SITE=true                  # Set true when behind HTTPS reverse proxy
# DEFAULT_LANGUAGE=en-US            # Default UI language
# ENCRYPTION_SECRET=                # Required for LDAP — generate with: openssl rand -hex 32
# OAUTH_ALLOWED_REDIRECT_HOSTS=     # Optional: comma-separated additional redirect hosts for custom OIDC providers

# ─── Reverse proxy (Traefik) deployment ─────────────────────────────────────
# Only needed for the "PRODUCTION EXAMPLE" at the bottom of docker-compose.yaml
# (single hostname, HTTPS, no host ports). For that setup, FRONTEND_ORIGIN and
# STORAGE_PUBLIC_URL above should use https:// on APP_HOST, e.g.:
#   FRONTEND_ORIGIN=https://files.example.com
#   STORAGE_PUBLIC_URL=https://files.example.com/ouitransfer-files
# APP_HOST=files.example.com               # public hostname used in Traefik rules
# STORAGE_DATA_PATH=/srv/ouitransfer/storage   # host bind-mount for S3 data
# SERVER_DATA_PATH=/srv/ouitransfer/server     # host bind-mount for DB + config
