# Ouitransfer — Root environment variables
# Copy to .env and adjust values for your environment

# ============================================================================
# Server (Backend) — Fastify API
# ============================================================================

# Storage backend selection
ENABLE_S3=false

# Filesystem encryption (set to false to enable encryption, requires ENCRYPTION_KEY)
DISABLE_FILESYSTEM_ENCRYPTION=true

# Encryption key for filesystem storage (required only if encryption is enabled)
# Must be at least 32 characters when DISABLE_FILESYSTEM_ENCRYPTION=false
# ENCRYPTION_KEY=change-this-key-in-production-min-32-chars

# Database connection string (SQLite by default)
DATABASE_URL="file:./ouitransfer.db"

# ============================================================================
# S3 Storage Configuration (when ENABLE_S3=true)
# ============================================================================

# S3 endpoint URL
# S3_ENDPOINT=

# S3 port (typically 9000 for MinIO, 443/80 for AWS)
# S3_PORT=

# Use SSL/TLS for S3 connection
# S3_USE_SSL=

# S3 access key (AWS Access Key ID or MinIO username)
# S3_ACCESS_KEY=

# S3 secret key (AWS Secret Access Key or MinIO password)
# S3_SECRET_KEY=

# S3 region (e.g., us-east-1 for AWS, ignored for MinIO)
# S3_REGION=

# S3 bucket name for storing uploads
# S3_BUCKET_NAME=

# Force path-style URLs instead of virtual-hosted-style (required for MinIO)
# S3_FORCE_PATH_STYLE=

# Reject unauthorized SSL certificates (set to false for self-signed certs)
# S3_REJECT_UNAUTHORIZED=true

# Presigned URL expiration time in seconds (default: 3600 = 1 hour)
# PRESIGNED_URL_EXPIRATION=3600

# ============================================================================
# Web Frontend (Next.js)
# ============================================================================

# Backend API base URL (must match server port, typically 3333)
API_BASE_URL=http://localhost:3333

# Default language for the frontend (e.g., en-US, fr-FR, de-DE)
NEXT_PUBLIC_DEFAULT_LANGUAGE=en-US

# Upload chunk size in megabytes (for chunked uploads)
NEXT_PUBLIC_UPLOAD_CHUNK_SIZE_MB=
