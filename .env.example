# Ouitransfer — Environment Variables
# Copy to .env and adjust values for your environment.
#
# For Docker Compose deployment, see docker-compose.yaml instead.
# This file is for local development (running apps directly on the host).

# ============================================================================
# Server (Backend) — Fastify API
# ============================================================================

# Database connection string (SQLite by default)
DATABASE_URL="file:./ouitransfer.db"

# ============================================================================
# S3 Storage Configuration
# ============================================================================
# The server always uses S3-compatible storage. For local development,
# run RustFS: docker run -p 9000:9000 -e RUSTFS_ACCESS_KEY=dev -e RUSTFS_SECRET_KEY=devsecret rustfs/rustfs:latest rustfs server /data
# For Docker deployment, also set RUSTFS_CORS_ALLOWED_ORIGINS to the web frontend origin
# (e.g., http://localhost:5487) so browsers can upload directly via presigned URLs.

# S3 endpoint hostname (e.g., localhost, storage.example.com, s3.amazonaws.com)
S3_ENDPOINT=localhost

# S3 port (typically 9000 for RustFS/MinIO, 443 for AWS)
S3_PORT=9000

# Use SSL/TLS for S3 connection
S3_USE_SSL=false

# S3 credentials
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devsecret

# S3 region
S3_REGION=auto

# S3 bucket name
S3_BUCKET_NAME=ouitransfer-files

# Force path-style URLs (required for RustFS, MinIO, and most self-hosted S3)
S3_FORCE_PATH_STYLE=true

# Reject unauthorized SSL certificates (set to false for self-signed certs)
# S3_REJECT_UNAUTHORIZED=true

# Public URL where browsers reach the storage (required when using internal storage)
# For local dev: http://localhost:9000
# For production: https://storage.yourdomain.com
# WARNING: Use HTTPS in production. HTTP exposes presigned URL signatures and file
# contents on the wire. Browsers block mixed-content requests if the web app is served
# over HTTPS but storage uses HTTP.
STORAGE_URL=http://localhost:9000

# External S3 mode (set to true for AWS S3, Backblaze B2, etc.)
# When true, STORAGE_URL is not needed — presigned URLs use S3_ENDPOINT directly.
# ENABLE_S3=true

# Presigned URL expiration (seconds)
# PRESIGNED_URL_EXPIRATION=3600
# PRESIGNED_GET_URL_EXPIRATION=900

# ============================================================================
# Security (REQUIRED — generate each with: openssl rand -hex 32)
# ============================================================================
# All FOUR secrets are REQUIRED and must be distinct. In production the server
# refuses to boot on a known placeholder or a low-entropy value (A8-01).

JWT_SECRET=
CSRF_SECRET=
COOKIE_SECRET=

# Encryption key for sensitive data at rest (2FA TOTP secret, LDAP bind password).
# REQUIRED (no longer optional). Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# Set to true when behind an HTTPS reverse proxy
# SECURE_SITE=true

# Trust proxy setting. SECURITY (A8-08): only set "true" (or a proxy CIDR) when
# the server is NOT directly reachable (reverse proxy is the sole ingress) —
# otherwise a client can forge X-Forwarded-For and bypass rate limits. Prefer a
# specific CIDR over "true". Default "loopback" is safe for direct-port setups.
# TRUST_PROXY=loopback

# Comma-separated list of additional OIDC/OAuth redirect hosts (for custom auth providers)
# OAUTH_ALLOWED_REDIRECT_HOSTS=auth.example.com,login.anotherdomain.com

# Self-hosted SSRF opt-ins (default OFF — only for trusted private networks):
# S3_ALLOW_PRIVATE_ENDPOINT=false
# STORAGE_ALLOWED_HOSTS=
# OAUTH_ALLOW_PRIVATE_ENDPOINT=false
# OAUTH_ALLOWED_ENDPOINT_HOSTS=
# Optional LDAP host lockdown (unset = any host except cloud metadata; the admin's directory server is their choice):
# LDAP_ALLOWED_HOSTS=

# API docs (A8-07): when "true", /swagger and /docs are exposed (admin-gated in
# production). NOT for internet-facing deployments — prefer leaving disabled.
# ENABLE_API_DOCS=false

# ============================================================================
# Web Frontend (Next.js)
# ============================================================================

# Backend API URL (must match server port)
API_BASE_URL=http://localhost:3333

# Default language (e.g., en-US, fr-FR, de-DE)
NEXT_PUBLIC_DEFAULT_LANGUAGE=en-US

# Additional origins for Content-Security-Policy connect-src and img-src (space-separated).
# Required when browsers upload/download directly to presigned S3 URLs on a different origin.
# Should match STORAGE_URL from the server configuration.
# Example: CSP_STORAGE_ORIGINS=http://localhost:9000
# CSP_STORAGE_ORIGINS=

# Application version shown in footer (injected at Docker build time from git tag)
# NEXT_PUBLIC_APP_VERSION=dev

# Canonical public origin (R6) — used for OpenGraph/canonical metadata and to
# validate the request host. Set to the exact origin browsers use.
# Example: APP_URL=https://files.example.com
# APP_URL=

# Upload chunk size in megabytes
NEXT_PUBLIC_UPLOAD_CHUNK_SIZE_MB=50
