{
  "name": "ouitransfer-api",
  "version": "0.0.0-dev",
  "description": "API for OUITRANSFER",
  "private": true,
  "type": "module",
  "author": "Burger&Cie",
  "keywords": [
    "OUITRANSFER",
    "api",
    "backend",
    "server",
    "nodejs",
    "typescript"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.0",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "reset-password.sh",
    "src/scripts",
    "src/shared"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env.development src/server.ts",
    "build": "tsc -p tsconfig.json && cp -r src/modules/email/i18n/messages dist/modules/email/i18n/",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "type-check": "tsc --noEmit",
    "validate": "pnpm lint && pnpm type-check",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.js",
    "cleanup:orphan-files": "tsx src/scripts/cleanup-orphan-files.ts",
    "cleanup:orphan-files:confirm": "tsx src/scripts/cleanup-orphan-files.ts --confirm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.817.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@ouitransfer/shared": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/fastify-api-reference": "^1.32.1",
    "@smithy/node-http-handler": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^4.0.2",
    "file-type": "^22.0.1",
    "jose": "catalog:",
    "ldapts": "^8.1.7",
    "nodemailer": "^8.0.7",
    "otpauth": "^9.5.0",
    "prisma": "^7.8.0",
    "qrcode": "catalog:",
    "sharp": "^0.34.2",
    "tsx": "^4.19.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
