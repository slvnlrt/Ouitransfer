# Development-only environment variables
# Loaded by `tsx --env-file` in the dev script. NOT used in production.
# For production config, see .env.example and docker-compose.yaml.

DATABASE_URL=file:./ouitransfer.db

# Security secrets (dev-only values — production MUST use unique random 32+ char secrets)
JWT_SECRET=dev-jwt-secret-ouitransfer-32chars!
CSRF_SECRET=dev-csrf-secret-ouitransfer-32char!
COOKIE_SECRET=dev-cookie-secret-ouitransfer-32ch

# S3 storage (local RustFS dev instance)
# Start with: docker run -p 9000:9000 -e RUSTFS_ACCESS_KEY=dev -e RUSTFS_SECRET_KEY=devsecret rustfs/rustfs:latest rustfs server /data
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devsecret
S3_REGION=auto
S3_BUCKET_NAME=ouitransfer-files
S3_FORCE_PATH_STYLE=true
STORAGE_URL=http://localhost:9000

# Dev mode settings
SECURE_SITE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5487,http://127.0.0.1:5487
