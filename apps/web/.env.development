# Development-only environment variables (loaded automatically by `next dev`)
# These are NOT used in production builds. See .env.example for production config.

# Backend API URL (must match server port)
API_BASE_URL=http://localhost:3333

# JWT secret for middleware token verification (must match server's JWT_SECRET)
# This is a dev-only value — production MUST use a unique, random 32+ char secret.
JWT_SECRET=dev-jwt-secret-ouitransfer-32chars!
